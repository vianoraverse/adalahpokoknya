# Salin menjadi .env lalu sesuaikan. Semua nilai opsional pada mode pengembangan.

PORT=4000

# PostgreSQL. Bila dikosongkan, server memakai PGlite (PostgreSQL tertanam)
# dan menyimpan data di folder data/pglite, tanpa perlu memasang apa pun.
DATABASE_URL=
# DATABASE_URL=postgres://yourway:yourway@localhost:5432/yourway

# Kunci untuk tiket login. Boleh dikosongkan saat dijalankan lokal.
JWT_SECRET=

# Akun Operator Admin pertama (dibuat sekali saat basis data masih kosong).
ADMIN_EMAIL=admin@yourway.local
ADMIN_PASSWORD=admin12345
